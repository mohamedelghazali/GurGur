# Generate an API key with: python -m app keygen
LAB_API_KEY=
LAB_DATABASE_PATH=./data/gurgur.sqlite3
LAB_BIND_HOST=127.0.0.1
LAB_BIND_PORT=8000

# Optional detached audit checkpoints. Keep this separate from LAB_API_KEY.
# Generate a value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
LAB_AUDIT_SIGNING_KEY=
LAB_AUDIT_SIGNING_KEY_ID=local-v1
